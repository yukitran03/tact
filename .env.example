# Walrus Memory (mainnet). Either set these, or keep the file the official MCP writes at ~/.memwal/credentials.json.
MEMWAL_KEY=                 # delegate private key (hex or suiprivkey1...)
MEMWAL_ACCOUNT_ID=          # 0x... MemWalAccount object id (run `bun run diagnose` if you get 401)
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Secrets: `openssl rand -hex 32` each.
TACT_NAMESPACE_SECRET=
TACT_SESSION_SECRET=

# Model. Default: local Ollama. For a hosted model set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:1.7b
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.5-flash

# How long the optional model polish of group replies may take (ms). 0 = always use the template.
TACT_POLISH_BUDGET_MS=12000
TACT_ANSWER_BUDGET_MS=25000
TACT_WRITES_PER_MINUTE=10

# Telegram (optional): token from @BotFather, then `bun run telegram`.
TELEGRAM_BOT_TOKEN=

PORT=8787
# TACT_MEMORY=mock          # run without Walrus (tests, offline demos)
